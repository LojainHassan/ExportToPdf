@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<div dir="rtl" class="mt-4">
    <a href="?handler=DownloadPdf" class="btn btn-danger mb-3">
        <i class="bi bi-file-earmark-pdf"></i> تصدير إلى PDF
    </a>
    <a href="?handler=DownloadExcel" class="btn btn-success mb-3 me-2">
        <i class="bi bi-file-earmark-excel"></i> تصدير إلى Excel
    </a>
    <a href="?handler=DownloadWord" class="btn btn-primary mb-3 me-2 text-white">
        <i class="bi bi-file-earmark-word"></i> تصدير إلى Word
    </a>
    <table class="table text-right">
        <thead>
            <tr>
                <th>رقم السجل</th>
                <th>رقم التصنيف</th>
                <th>عنوان السجل</th>
                <th>نوع السجل</th>
                <th>وقت الإنشاء</th>
            </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.SearchModels)
        {
            <tr>
                <td>@item.RecordNo</td>
                <td>@item.CalssificationNo</td>
                <td>@item.RecordTitle</td>
                <td>@item.RecordType</td>
                <td>@item.CreationTime.ToString("g")</td>
            </tr>
        }
    </tbody>
    </table>
</div>